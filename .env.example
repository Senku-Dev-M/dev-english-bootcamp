# DevEnglish usa el modelo "Bring Your Own Key" (BYOK):
# la API Key de OpenRouter se introduce DESDE LA APP (botón de ajustes ⚙️)
# y se guarda en el localStorage del navegador. No necesitas poner tu key aquí.
#
# Esta variable solo define el MODELO por defecto que se sugiere en la app.
NEXT_PUBLIC_DEFAULT_MODEL=openrouter/free

# Consigue una API Key gratis/barata en: https://openrouter.ai/keys
